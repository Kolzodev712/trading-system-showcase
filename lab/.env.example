# Sibling checkouts. Paths are relative to lab/ (this directory).
# workspace/
#   trading_system/
#   k-paper/
#   trading-system-ui/
#   trading-system-showcase/lab/   ← you are here
TRADING_SYSTEM_DIR=../../trading_system
K_PAPER_DIR=../../k-paper
UI_DIR=../../trading-system-ui

# release = stage pinned Git revisions from compatibility.json (default)
# dev     = stage current working trees (local modifications; not reproducible)
LAB_SOURCE_MODE=release

# Local auth signing key for the demonstration only. Not a production secret.
JWT_SECRET=showcase-lab-change-me

# Runner level profile: normal or risk-rejection.
SHOWCASE_PROFILE=normal
